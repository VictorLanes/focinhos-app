<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz"
    android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
    <ImageView android:id="@+id/fundo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_fundo" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp">
        <ImageView android:id="@+id/foto" android:layout_width="64dp" android:layout_height="64dp" android:scaleType="fitCenter"
            android:src="@drawable/ic_pata" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/nome" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Meu dog" android:textColor="#FFFFFFFF" android:textSize="19sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium"/>
            <TextView android:id="@+id/linha1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Raça · idade" android:textColor="#E6FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/linha2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:background="@drawable/widget_tag" android:paddingStart="8dp" android:paddingEnd="8dp"
                android:paddingTop="2dp" android:paddingBottom="2dp"
                android:text="💉 Vacinas em dia" android:textColor="#FFFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/linha3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="🔔 Sem lembretes" android:textColor="#E6FFFFFF" android:textSize="12sp"
                android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <ImageView android:id="@+id/qr" android:layout_width="84dp" android:layout_height="match_parent" android:scaleType="fitCenter" android:layout_marginStart="8dp"
            android:visibility="gone" android:importantForAccessibility="no"/>
    </LinearLayout>
</FrameLayout>
